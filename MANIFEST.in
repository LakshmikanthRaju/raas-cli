include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md MANIFEST.in run.py
recursive-include docs *.md
recursive-include examples *.yaml *.yml *.json *.sls *.jinja *.md
recursive-include salt_modules *.yaml *.yml *.sls *.py
recursive-include tests *.py
recursive-include scripts *.py
recursive-include .github *.yml *.yaml
global-exclude __pycache__ *.py[cod]
